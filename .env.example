# Variables de entorno de la encuesta.
# Copia este archivo como .env y pon la contraseña. El archivo .env tiene
# contraseñas: no se sube al repositorio ni se manda por correo o chat.

# ── Base de datos: MySQL 8.0 de la entidad, en Google Cloud SQL ────────────
# Las tablas y el usuario ya están creados (ver db/esquema.sql y el README).

MYSQL_HOST=35.202.252.42
MYSQL_PORT=3306
MYSQL_DATABASE=planeacionbd

# Usuario de la aplicación: solo tiene los permisos que indica db/esquema.sql
MYSQL_USER=encuesta_app

# Contraseña de ese usuario, entre comillas simples: si tiene # o $ sin
# comillas, el archivo los toma como comentario o como otra variable y la
# contraseña llega vacía o recortada.
MYSQL_PASSWORD=''

# Conexión cifrada con la base (recomendado: la conexión va por internet).
# Pon aquí la ruta completa del certificado del servidor que entrega Google
# Cloud SQL (server-ca.pem). Con él se cifra la conexión y se verifica el servidor.
# MYSQL_SSL_CA=/opt/encuesta/server-ca.pem
MYSQL_SSL=false

# Conexiones abiertas a la vez como máximo, por proceso
MYSQL_CONEXIONES=10
